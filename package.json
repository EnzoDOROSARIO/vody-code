{
  "name": "vody-code",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "typecheck": "tsc -b",
    "lint": "oxlint --disable-nested-config .",
    "lint:fix": "oxlint --disable-nested-config . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test": "bun test",
    "agent": "bun run --cwd packages/agent dev",
    "tui": "bun run --cwd packages/tui dev",
    "prepare": "effect-tsgo patch --typescript --oxlint && lefthook install"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@oxlint/plugins": "1.82.0",
    "@types/bun": "latest",
    "lefthook": "^2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  }
}
