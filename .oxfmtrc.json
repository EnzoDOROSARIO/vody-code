{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "printWidth": 100,
  "arrowParens": "always",
  "bracketSpacing": true,
  "ignorePatterns": ["repos/**", "coverage/**", ".oxlint/**", "bun.lockb", "**/*.gen.ts", "*.md"]
}
