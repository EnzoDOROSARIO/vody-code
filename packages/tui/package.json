{
  "name": "tui",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "tui": "./dist/cli.js"
  },
  "type": "module",
  "module": "src/index.tsx",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": "./src/index.tsx"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "node --import tsx --watch src/cli.ts",
    "start": "pnpm build && node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "agent": "workspace:*",
    "chalk": "5.6.2",
    "effect": "catalog:",
    "ink": "7.1.1",
    "marked": "18.0.13",
    "react": "19.3.0",
    "string-width": "8.2.2"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "vitest": "catalog:"
  }
}
